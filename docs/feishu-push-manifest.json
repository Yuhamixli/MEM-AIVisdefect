{
  "$schema_comment": "仓库 → 飞书自动推送清单。CI 在 main 变更命中 include 时执行 push-docs；无需手工上传。",
  "version": 1,
  "targetFolderEnv": "FEISHU_PUSH_FOLDER_TOKEN",
  "targetFolderFallback": "JviVfMA56lMkzhdVoZdcEVk9nBd",
  "stateFile": "docs/agent-knowledge-base/feishu-sync/PUSH_STATE.json",
  "include": [
    "docs/design/**/*.md",
    "docs/design/**/*.docx",
    "docs/02-tech-research/**/*.md",
    "docs/project-management/**/*.md",
    "docs/agent-knowledge-base/*.md"
  ],
  "exclude": [
    "docs/agent-knowledge-base/feishu-sync/**",
    "**/node_modules/**",
    "**/.tmp*/**",
    "**/_*/**",
    "**/_*.md",
    "**/_*.docx",
    "**/_*.txt",
    "**/_*.py",
    "**/*-formal.docx",
    "**/*-humanized.md",
    "**/~$*",
    "**/*.LNK"
  ],
  "folderRoutes": [
    { "match": "docs/02-tech-research/**", "folder": "03-技术方案" },
    { "match": "docs/design/**", "folder": "03-技术方案" },
    { "match": "docs/project-management/**", "folder": "08-项目管理" },
    { "match": "docs/agent-knowledge-base/**", "folder": "00-入口" }
  ],
  "titleMaxChars": 27,
  "commitStateInCi": true
}
