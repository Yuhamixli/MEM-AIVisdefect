{
  "name": "feishu-cursor-bridge",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Feishu bot ↔ Cursor SDK bridge for MEM-AIVisdefect",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "watchdog": "node scripts/watchdog.mjs",
    "sync-docs": "tsx scripts/sync-feishu-docs.ts",
    "push-docs": "tsx scripts/push-feishu-docs.ts",
    "tidy-drive": "tsx scripts/tidy-feishu-drive.ts",
    "tidy-drive:apply": "tsx scripts/tidy-feishu-drive.ts --apply",
    "typecheck": "tsc --noEmit"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@cursor/sdk": "^1.0.18",
    "@larksuiteoapi/node-sdk": "^1.55.0",
    "dotenv": "^16.6.1",
    "tsx": "^4.20.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.8.3"
  }
}
