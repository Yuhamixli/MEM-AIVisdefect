# Cursor — https://cursor.com/dashboard/integrations
CURSOR_API_KEY=cursor_xxxxxxxx

# Feishu app (MEM-AIVisdefect-Agent)
FEISHU_APP_ID=cli_xxxxxxxx
FEISHU_APP_SECRET=xxxxxxxx
# Optional; auto-resolved from /bot/v3/info
# FEISHU_BOT_OPEN_ID=ou_xxxxxxxx

# cloud (default) | local
CURSOR_RUNTIME=cloud
CURSOR_CLOUD_REPO=https://github.com/Yuhamixli/MEM-AIVisdefect
CURSOR_CLOUD_REF=main

# Only for CURSOR_RUNTIME=local
# REPO_CWD=A:/Projects/MEM-AIVisdefect

CURSOR_MODEL=grok-4.5
REQUIRE_MENTION=true
MAX_REPLY_CHARS=3500

# Attach recent group messages to each @ (0 = off)
RECENT_CHAT_LIMIT=40

# npm run sync-docs  (飞书 → 仓库)
FEISHU_SYNC_FOLDER_TOKEN=JviVfMA56lMkzhdVoZdcEVk9nBd
# FEISHU_SYNC_OUT=../../docs/agent-knowledge-base/feishu-sync
FEISHU_SYNC_MAX_DOCS=80

# npm run push-docs  (仓库 → 飞书；CI 自动跑)
# 默认与 SYNC 同文件夹；可拆到「仓库镜像」子目录以避免和人工编辑互相覆盖
# FEISHU_PUSH_FOLDER_TOKEN=JviVfMA56lMkzhdVoZdcEVk9nBd

# Health + watchdog
HEALTH_PORT=8787
WATCHDOG_CHECK_MS=30000
WATCHDOG_FAILS=3
WATCHDOG_MAX_UPTIME_MS=21600000
# No Feishu events for this long → advisory stale → watchdog soft-recycle.
HEALTH_MAX_SILENT_MS=2700000

# Org ops: log all user↔bot turns (incl. DMs) under .data/conversations/
CONVERSATION_LOG=true
# Required to open http://<bridge>:8787/admin/conversations?token=...
# Generate: node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
# On Synology you may instead put the same value in file admin.token (one line).
ADMIN_TOKEN=

